# Postgres connection strings (Neon, Supabase, Railway, or local docker-compose).
# DATABASE_URL: pooled connection used by the app at runtime (e.g. Supabase transaction pooler, port 6543).
DATABASE_URL="postgresql://user:password@localhost:5432/memoria"
# DIRECT_URL: direct/session connection used by the Prisma CLI (migrate, db push, ...).
# Same as DATABASE_URL if you're not going through a pooler (e.g. plain local docker-compose Postgres).
DIRECT_URL="postgresql://user:password@localhost:5432/memoria"
